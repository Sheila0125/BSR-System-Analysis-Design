{
  "name": "bsr-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run",
    "build": "npm run type-check && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.8"
  }
}

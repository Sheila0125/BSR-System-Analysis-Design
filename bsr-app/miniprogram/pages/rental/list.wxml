<wxs module="ui" src="../../shared/ui/presentation.wxs" />
<view class="rental-page with-nav">
  <view class="page-heading"><text class="eyebrow">你的每一次滑行，都有记录</text><text class="page-title">我的租赁</text><text class="description">查看合同、装备和费用，安心享受雪季。</text></view>
  <view wx:if="{{loading}}" class="loading-state">正在获取租赁记录…</view><text wx:if="{{error}}" class="error">{{ui.message(error)}}</text><navigator wx:if="{{error}}" class="text-link" url="/pages/identity/login">重新登录 ›</navigator>
  <view class="section-heading"><text class="section-title">当前租赁</text><text wx:if="{{!loading && !error}}" class="caption">{{current.length}} 份合同</text></view>
  <view wx:if="{{!loading && !error && current.length === 0}}" class="empty-state"><view class="empty-mark">≡</view><text class="empty-title">暂时没有进行中的租赁</text><text class="caption">门店确认申请后，你的合同将显示在这里。</text><navigator class="text-link" url="/pages/customerrequest/home">查看我的申请 ›</navigator></view>
  <button wx:for="{{current}}" wx:key="contractId" class="contract-card" data-id="{{item.contractId}}" bindtap="open"><view class="card-row"><text class="contract-number break-id">{{item.contractNumber}}</text><text class="status-badge">{{ui.label(item.status)}}</text></view><view class="contract-date"><text>{{item.rentalStartDate}}</text><text>{{item.rentalDays}} 天</text></view><view class="contract-bottom"><view><text class="amount-label">合同应付金额</text><text class="contract-amount">{{item.amountDue}}</text></view><text class="caption">查看合同 ›</text></view></button>
  <view class="section-heading"><text class="section-title">历史记录</text><text class="caption">留住每一段雪季</text></view>
  <view wx:if="{{!loading && !error && history.length === 0}}" class="history-empty">还没有已结束的租赁记录</view>
  <button wx:for="{{history}}" wx:key="contractId" class="contract-card contract-card--history" data-id="{{item.contractId}}" bindtap="open"><view class="card-row"><text class="contract-number break-id">{{item.contractNumber}}</text><text class="status-badge">{{ui.label(item.status)}}</text></view><view class="contract-date"><text>{{item.rentalStartDate}} · {{item.rentalDays}} 天</text><text>{{item.amountDue}}</text></view></button>
  <view class="bottom-nav"><navigator class="nav-item" url="/pages/customerrequest/home"><text class="nav-icon">▤</text>租赁申请</navigator><view class="nav-item nav-item--active"><text class="nav-icon">≡</text>我的租赁</view><navigator class="nav-item" url="/pages/customerrequest/profile"><text class="nav-icon">↕</text>我的资料</navigator></view>
</view>

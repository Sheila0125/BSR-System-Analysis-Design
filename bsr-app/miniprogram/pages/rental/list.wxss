.contract-card { display:block; width:100%; padding:28rpx; margin-bottom:22rpx; border:1rpx solid #e1ebf3; border-radius:24rpx; background:#fff; text-align:left; line-height:1.6; font-weight:400; }
.contract-number { flex:1; min-width:0; font-size:28rpx; color:#365a70; font-weight:600; }
.contract-date { display:flex; justify-content:space-between; gap:14rpx; margin-top:24rpx; color:#7893a5; font-size:24rpx; }
.contract-bottom { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-top:24rpx; padding-top:24rpx; border-top:1rpx solid #edf3f7; }
.contract-amount { display:block; font-size:38rpx; color:#285c79; font-weight:650; }
.contract-card--history { background:#fbfdfe; }
.contract-card--history .status-badge { background:#eef2f5; color:#8ba0ae; }
.history-empty { padding:28rpx; color:#9aadb9; font-size:24rpx; text-align:center; }

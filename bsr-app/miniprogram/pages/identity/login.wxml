<wxs module="ui" src="../../shared/ui/presentation.wxs" />
<view class="login-page">
  <view class="login-hero">
    <view class="brand-row"><view class="brand-symbol"></view><text class="brand-name">BSR</text><text class="brand-caption">雪具租赁</text></view>
    <text class="login-hero__title">下一程，<text class="login-hero__title-line">向雪山出发。</text></text>
    <text class="login-hero__subtitle">从挑选装备，到记录每一次雪季。</text>
    <view class="snow-scene"><view class="snow-mountain snow-mountain--back"></view><view class="snow-mountain"></view><view class="snow-mountain snow-mountain--front"></view><view class="snow-slope"></view></view>
    <view class="hero-pill">装备租赁 · 申请进度 · 我的合同</view>
  </view>
  <view class="login-card">
    <text class="login-card__title">欢迎回来</text><text class="login-card__subtitle">登录顾客账号，开启你的雪季</text>
    <text class="field-label">账号</text>
    <input class="field-input" value="{{loginName}}" maxlength="100" placeholder="请输入门店分配的账号" placeholder-class="input-placeholder" disabled="{{submitting}}" bindinput="onLoginName" />
    <text class="field-label">密码</text>
    <input class="field-input" value="{{password}}" maxlength="255" password placeholder="请输入密码" placeholder-class="input-placeholder" disabled="{{submitting}}" bindinput="onPassword" />
    <text wx:if="{{errorMessage}}" class="login-card__error">{{ui.message(errorMessage)}}</text>
    <button type="primary" class="login-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在登录' : '登录，开启雪季'}}<text wx:if="{{!submitting}}" class="button-arrow">↗</text></button>
    <text class="login-help">账号遇到问题？请联系服务门店</text>
  </view>
  <text class="page-footer">BSR · 每次出发，都有所期待</text>
</view>

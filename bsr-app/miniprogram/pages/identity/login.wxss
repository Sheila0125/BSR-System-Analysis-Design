.login-page { padding:20rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); }
.login-hero { position:relative; overflow:hidden; min-height:490rpx; padding:36rpx 34rpx; border-radius:32rpx; color:#fff; background:linear-gradient(140deg,#123f60,#2c6e91); }
.login-hero__title { position:relative; z-index:2; display:block; margin:42rpx 0 12rpx; font-size:52rpx; font-weight:650; line-height:1.42; letter-spacing:2rpx; }
.login-hero__title-line { display:block; }
.login-hero__subtitle { position:relative; z-index:2; display:block; color:#c0dce9; font-size:23rpx; }
.hero-pill { position:absolute; z-index:3; bottom:28rpx; left:30rpx; padding:9rpx 18rpx; border:1rpx solid rgba(255,255,255,.25); border-radius:30rpx; font-size:20rpx; color:#e4f1f7; background:rgba(15,52,80,.17); }
.snow-scene { position:absolute; right:-100rpx; bottom:0; width:420rpx; height:370rpx; }
.snow-mountain { position:absolute; width:240rpx; height:240rpx; background:linear-gradient(135deg,#f2fbff,#89b9d0); transform:rotate(45deg); border-radius:10rpx; bottom:-60rpx; left:70rpx; }
.snow-mountain--back { width:180rpx; height:180rpx; left:-30rpx; bottom:-28rpx; opacity:.45; }
.snow-mountain--front { width:200rpx; height:200rpx; left:230rpx; bottom:-84rpx; background:#beddeb; }
.snow-slope { position:absolute; width:500rpx; height:90rpx; bottom:-65rpx; left:-130rpx; background:#e5f3fa; transform:rotate(-12deg); border-radius:50%; }
.login-card { position:relative; z-index:4; margin:24rpx 0 0; padding:36rpx 32rpx 28rpx; border-radius:30rpx; border:1rpx solid #e3edf4; background:#fff; box-shadow:0 12rpx 32rpx rgba(30,67,89,.04); }
.login-card__title { display:block; font-size:39rpx; font-weight:700; color:#173b51; }
.login-card__subtitle { display:block; margin-top:6rpx; color:#8ba0af; font-size:24rpx; }
.login-card .field-label { margin-top:28rpx; }
.login-submit { margin-top:34rpx; }
.button-arrow { margin-left:18rpx; font-size:32rpx; font-weight:400; }
.login-help { display:block; margin-top:24rpx; color:#94a6b4; text-align:center; font-size:22rpx; }

<wxs module="ui" src="../../shared/ui/presentation.wxs" />
<view class="customer-page with-nav">
  <view class="home-hero">
    <view class="brand-row"><view class="brand-symbol"></view><text class="brand-name">BSR</text><text class="brand-caption">你的雪季管家</text></view>
    <text class="home-hero__title">准备好，向雪山出发。</text><text class="home-hero__subtitle">挑选所需装备，其余交给门店。</text>
    <button class="hero-action" size="mini" bindtap="openCreate">＋ 新建租赁申请</button>
    <view class="home-mountain"></view>
  </view>
  <view class="quick-links">
    <navigator class="quick-link" url="/pages/rental/list" open-type="reLaunch"><text class="quick-link__icon">≡</text><view><text class="quick-link__title">我的租赁</text><text class="caption">合同、装备与费用</text></view><text class="quick-link__arrow">›</text></navigator>
    <navigator class="quick-link" url="/pages/customerrequest/profile" open-type="reLaunch"><text class="quick-link__icon">↕</text><view><text class="quick-link__title">我的资料</text><text class="caption">联系资料与装备尺寸</text></view><text class="quick-link__arrow">›</text></navigator>
  </view>
  <view class="section-heading"><text class="section-title">我的申请</text><text wx:if="{{!loading && !errorMessage}}" class="caption">共 {{requests.length}} 条</text></view>
  <text wx:if="{{errorMessage}}" class="customer-page__error">{{ui.message(errorMessage)}}</text>
  <button wx:if="{{errorMessage}}" class="button-secondary" size="mini" bindtap="onShow" disabled="{{loading}}">重新加载</button>
  <view wx:if="{{loading}}" class="loading-state">正在获取你的申请…</view>
  <view wx:elif="{{!errorMessage && requests.length === 0}}" class="empty-state"><view class="empty-mark">＋</view><text class="empty-title">你的下一次出发，从这里开始</text><text class="caption">还没有租赁申请，先告诉我们你的需求吧。</text><button size="mini" class="button-secondary" bindtap="openCreate">新建申请</button></view>
  <view wx:for="{{requests}}" wx:key="requestId" class="request-card" data-request-id="{{item.requestId}}" bindtap="openDetail">
    <view class="card-row"><text class="request-card__number break-id">{{item.requestNumber}}</text><text class="status-badge">{{ui.label(item.status)}}</text></view>
    <view class="request-card__date"><text>{{item.rentalStartDate}}</text><text>{{item.rentalDays}} 天 · {{ui.label(item.skillLevel)}}</text></view>
    <view class="request-card__footer"><text>服务门店 · {{item.serviceStoreId}}</text><text>查看详情 ›</text></view>
  </view>
  <view class="bottom-nav"><view class="nav-item nav-item--active"><text class="nav-icon">▤</text>租赁申请</view><navigator class="nav-item" url="/pages/rental/list" open-type="reLaunch"><text class="nav-icon">≡</text>我的租赁</navigator><navigator class="nav-item" url="/pages/customerrequest/profile" open-type="reLaunch"><text class="nav-icon">↕</text>我的资料</navigator></view>
</view>
